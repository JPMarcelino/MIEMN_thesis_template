% Example: Journal Article
@article{smith2020example,
  title   = {Example Journal Article Title},
  author  = {Smith, John and Doe, Jane},
  journal = {Example Journal},
  volume  = {15},
  number  = {3},
  pages   = {123--145},
  year    = {2020},
  doi     = {10.1000/example}
}

% Example: Conference Paper
@inproceedings{jones2019example,
  author    = {Jones, Robert and Williams, Sarah},
  title     = {Example Conference Paper Title},
  booktitle = {Proceedings of the Example Conference},
  year      = {2019},
  pages     = {100--105},
  doi       = {10.1109/example.2019.1234567}
}

% Example: Book
@book{brown2018book,
  author    = {Brown, Michael},
  title     = {Example Book Title},
  publisher = {Example Publisher},
  year      = {2018},
  isbn      = {978-0-123456-78-9}
}

% Example: Book Chapter
@inbook{davis2017chapter,
  author    = {Davis, Emily},
  title     = {Example Chapter Title},
  booktitle = {Example Book Collection},
  year      = {2017},
  publisher = {Example Publisher},
  pages     = {50--75}
}

% Example: PhD Thesis
@phdthesis{miller2016thesis,
  author = {Miller, David},
  title  = {Example PhD Thesis Title},
  school = {Example University},
  year   = {2016}
}

% Example: Master's Thesis
@mastersthesis{taylor2015thesis,
  author = {Taylor, Jennifer},
  title  = {Example Master's Thesis Title},
  school = {Example University},
  year   = {2015}
}

% Example: Tech Report
@techreport{wilson2014report,
  author      = {Wilson, Christopher},
  title       = {Example Technical Report},
  institution = {Example Institution},
  year        = {2014},
  number      = {TR-1234}
}

% Example: Website
@misc{example2023website,
  author       = {Example Author},
  title        = {Example Website Title},
  howpublished = {\url{https://www.example.com}},
  year         = {2023},
  note         = {Accessed: 2025-01-13}
}

% Example: Preprint
@misc{lee2022arxiv,
  author       = {Lee, Kevin},
  title        = {Example Preprint Title},
  howpublished = {arXiv e-print 1234.5678},
  month        = {June},
  year         = {2022},
  note         = {Available: arxiv.org/abs/1234.5678}
}

% Example: Standard
@misc{iso2018standard,
  author       = {{International Organization for Standardization}},
  title        = {Example Standard},
  year         = {2018},
  number       = {ISO 12345:2018}
}

